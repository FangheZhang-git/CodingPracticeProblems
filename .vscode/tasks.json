{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "compile C++",
        "type": "shell",
        "command": "g++",
        "args": [
          "-std=c++17",
          "-O2",
          "${file}",
          "-o",
          "${fileDirname}/program"
        ],
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "run C++",
        "type": "shell",
        "command": "${fileDirname}/program",
        "dependsOn": "compile C++",
        "problemMatcher": []
      }
    ]
  }